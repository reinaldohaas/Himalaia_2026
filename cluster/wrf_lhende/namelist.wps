&share
 wrf_core = 'ARW',
 max_dom = 3,
 start_date = '2026-08-25_00:00:00', '2026-08-25_00:00:00', '2026-08-25_12:00:00',
 end_date   = '2026-08-26_03:00:00', '2026-08-25_00:00:00', '2026-08-25_12:00:00',
 interval_seconds = 3600,
 io_form_geogrid = 2,
 debug_level = 0,
/

&geogrid
 parent_id         =   1,   1,   2,
 parent_grid_ratio =   1,   3,   3,
 i_parent_start    =   1,  70,  61,
 j_parent_start    =   1,  64,  61,
 e_we              = 240, 334, 151,
 e_sn              = 190, 226, 151,
 geog_data_res     = 'default', 'default', 'default',
 dx = 9000,
 dy = 9000,
 map_proj  = 'lambert',
 ref_lat   = 28.5,
 ref_lon   = 87.5,
 truelat1  = 25.0,
 truelat2  = 32.0,
 stand_lon = 87.5,
 geog_data_path = 'GEOG_DATA_PATH',
 opt_geogrid_tbl_path = 'WPS_DIR/geogrid/',
/

&ungrib
 out_format = 'WPS',
 prefix = 'ERA5',
/

&metgrid
 fg_name = 'ERA5',
 io_form_metgrid = 2,
 opt_metgrid_tbl_path = 'WPS_DIR/metgrid/',
/
