    <!-- ====================================================== -->
    <!-- 1. LAGO GLACIAL & GELEIRAS DO LHENDE KHOLA             -->
    <!-- ====================================================== -->
    <Folder>
      <name>1. Lago e Geleira do Lhende Khola (Origem)</name>
      
      <Placemark>
        <name>Geleira da Face Norte (Mt. Langtang Lirung 5.200m)</name>
        <description><![CDATA[
          <b>Local:</b> Maciço do Langtang Lirung (7.245 m)<br>
          <b>Altitude:</b> ~5.200 m<br>
          <b>Evento:</b> Desprendimento de bloco maciço de gelo e permafrost rochoso gerando o sinal sísmico de 4.4 mb.
        ]]></description>
        <styleUrl>#styleGlacier</styleUrl>
        <Polygon>
          <extrude>1</extrude>
          <altitudeMode>relativeToGround</altitudeMode>
          <outerBoundaryIs>
            <LinearRing>
              <coordinates>
                85.5120,28.2810,350
                85.5250,28.2810,350
                85.5240,28.2730,200
                85.5110,28.2730,200
                85.5120,28.2810,350
              </coordinates>
            </LinearRing>
          </outerBoundaryIs>
        </Polygon>
      </Placemark>

      <Placemark>
        <name>Lago de Barramento do Rio Lhende Khola (~3.950m)</name>
        <description><![CDATA[
          <b>Altitude:</b> ~3.950 m<br>
          <b>Mecanismo:</b> Lago efêmero formado pelo represamento da garganta por milhões de m³ de detritos, cujo rompimento desencadeou a torrente.
        ]]></description>
        <styleUrl>#styleLake</styleUrl>
        <Polygon>
          <extrude>1</extrude>
          <altitudeMode>clampToGround</altitudeMode>
          <outerBoundaryIs>
            <LinearRing>
              <coordinates>
                85.4740,28.2760,0
                85.4880,28.2760,0
                85.4920,28.2720,0
                85.4780,28.2715,0
                85.4740,28.2760,0
              </coordinates>
            </LinearRing>
          </outerBoundaryIs>
        </Polygon>
      </Placemark>
    </Folder>

    <!-- ====================================================== -->
    <!-- 2. USINAS HIDRELÉTRICAS E BARRAGENS (>1.200 MW)        -->
    <!-- ====================================================== -->
    <Folder>
      <name>2. Usinas Hidrelétricas e Barragens</name>
      
      <Placemark>
        <name>UHE Rasuwagadhi (111 MW)</name>
        <description><![CDATA[
          <b>Capacidade:</b> 111 MW | <b>Status:</b> Inundada / Em Reparos<br>
          <b>Local:</b> Rio Bhote Koshi (Rasuwa) | <b>Altitude:</b> 1.780 m<br>
          <b>Dano:</b> Inundação das comportas de desvio, desarenadores e casa de força subterrânea.
        ]]></description>
        <styleUrl>#styleHydroDam</styleUrl>
        <Point><coordinates>85.3780,28.2650,1780</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>UHE Chilime (22.1 MW)</name>
        <description><![CDATA[
          <b>Capacidade:</b> 22.1 MW | <b>Status:</b> Operação sob Emergência<br>
          <b>Local:</b> Afluente Chilime Khola | <b>Altitude:</b> 1.550 m<br>
          <b>Dano:</b> Assoreamento severo do canal adutor e desarenadores.
        ]]></description>
        <styleUrl>#styleHydroDam</styleUrl>
        <Point><coordinates>85.3050,28.1880,1550</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>UHE Sanjen e Upper Sanjen (57.3 MW)</name>
        <description><![CDATA[
          <b>Capacidade Combinada:</b> 57.3 MW<br>
          <b>Local:</b> Encostas superiores do Rio Chilime (Rasuwa)<br>
          <b>Altitude:</b> 2.150 m
        ]]></description>
        <styleUrl>#styleHydroDam</styleUrl>
        <Point><coordinates>85.2750,28.2050,2150</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>UHE Upper Trishuli-1 (216 MW)</name>
        <description><![CDATA[
          <b>Capacidade:</b> 216 MW | <b>Status:</b> Em Construção (IFC / KOSEP)<br>
          <b>Local:</b> Mailung / Haku (Rasuwa) | <b>Altitude:</b> 1.090 m<br>
          <b>Descrição:</b> Mega-projeto subterrâneo na garganta profunda do Trishuli.
        ]]></description>
        <styleUrl>#styleHydroDam</styleUrl>
        <Point><coordinates>85.2530,28.0670,1090</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>UHE Upper Trishuli-3A (60 MW)</name>
        <description><![CDATA[
          <b>Capacidade:</b> 60 MW | <b>Status:</b> Operacional (NEA)<br>
          <b>Local:</b> Nuwakot (Barragem em Salletar / Casa de Força em Simle)<br>
          <b>Altitude:</b> 830 m
        ]]></description>
        <styleUrl>#styleHydroDam</styleUrl>
        <Point><coordinates>85.1800,27.9700,830</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>UHE Upper Trishuli-3B (37 MW)</name>
        <description><![CDATA[
          <b>Capacidade:</b> 37 MW | <b>Status:</b> Em Obras<br>
          <b>Local:</b> Nuwakot (Cascata abaixo de 3A)<br>
          <b>Altitude:</b> 750 m
        ]]></description>
        <styleUrl>#styleHydroDam</styleUrl>
        <Point><coordinates>85.1700,27.9550,750</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>UHE Trishuli Histórica (24 MW)</name>
        <description><![CDATA[
          <b>Capacidade:</b> 24 MW | <b>Status:</b> Operacional (Construída em 1967)<br>
          <b>Local:</b> Bidur / Trishuli Bazar (Nuwakot)<br>
          <b>Altitude:</b> 600 m
        ]]></description>
        <styleUrl>#styleHydroDam</styleUrl>
        <Point><coordinates>85.1450,27.9050,600</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>UHE Devighat (14 MW)</name>
        <description><![CDATA[
          <b>Capacidade:</b> 14 MW | <b>Status:</b> Operacional (1984)<br>
          <b>Local:</b> Devighat (Nuwakot)<br>
          <b>Altitude:</b> 520 m
        ]]></description>
        <styleUrl>#styleHydroDam</styleUrl>
        <Point><coordinates>85.1200,27.8750,520</coordinates></Point>
      </Placemark>
    </Folder>

    <!-- ====================================================== -->
    <!-- 3. CIDADES, VILAS E POLOS LOGÍSTICOS                   -->
    <!-- ====================================================== -->
    <Folder>
      <name>3. Cidades, Vilas e Postos Estratégicos</name>
      
      <Placemark>
        <name>Porto Terrestre de Gyirong (Tibete, China)</name>
        <description><![CDATA[
          <b>Jurisdição:</b> Região Autônoma do Tibete, China<br>
          <b>Altitude:</b> 2.700 m<br>
          <b>Impacto:</b> Complexo aduaneiro e de imigração soterrado por lama.
        ]]></description>
        <styleUrl>#styleTown</styleUrl>
        <Point><coordinates>85.3300,28.3970,2700</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Forte e Posto de Rasuwagadhi (Nepal)</name>
        <description><![CDATA[
          <b>Altitude:</b> 1.814 m (Divisa Internacional)<br>
          <b>Impacto:</b> Ponte da Amizade Miteri destruída e pátios aduaneiros varridos.
        ]]></description>
        <styleUrl>#styleTown</styleUrl>
        <Point><coordinates>85.3815,28.2732,1814</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Vila de Timure</name>
        <description><![CDATA[
          <b>Altitude:</b> 1.750 m (Distrito de Rasuwa)<br>
          <b>Impacto:</b> Soterramento massivo sob 6 metros de cascalho e lama.
        ]]></description>
        <styleUrl>#styleTown</styleUrl>
        <Point><coordinates>85.3850,28.2520,1750</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Syabrubesi (Entrada de Langtang)</name>
        <description><![CDATA[
          <b>Altitude:</b> 1.460 m (Distrito de Rasuwa)<br>
          <b>Impacto:</b> Confluência do Rio Langtang Khola; pontes destruídas e corte viário.
        ]]></description>
        <styleUrl>#styleTown</styleUrl>
        <Point><coordinates>85.3370,28.1610,1460</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Dhunche (Capital de Rasuwa)</name>
        <description><![CDATA[
          <b>Altitude:</b> 2.030 m<br>
          <b>Função:</b> Sede administrativa distrital e base de comando de resgate e saúde.
        ]]></description>
        <styleUrl>#styleTown</styleUrl>
        <Point><coordinates>85.3000,28.1130,2030</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Mailung</name>
        <description><![CDATA[
          <b>Altitude:</b> 1.090 m (Cânion do Trishuli)<br>
          <b>Impacto:</b> Canteiros de obras da UHE UT-1 atingidos; pontes de acesso varridas.
        ]]></description>
        <styleUrl>#styleTown</styleUrl>
        <Point><coordinates>85.2530,28.0670,1090</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Betrawati</name>
        <description><![CDATA[
          <b>Altitude:</b> 885 m (Fronteira Rasuwa-Nuwakot)<br>
          <b>Impacto:</b> Pontes Betrawati Old e New destruídas pela onda de cheia.
        ]]></description>
        <styleUrl>#styleTown</styleUrl>
        <Point><coordinates>85.2040,28.0020,885</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Bidur / Trishuli Bazar (Capital de Nuwakot)</name>
        <description><![CDATA[
          <b>Altitude:</b> 600 m (Distrito de Nuwakot)<br>
          <b>Função:</b> Polo urbano e comercial do vale médio do Trishuli.
        ]]></description>
        <styleUrl>#styleTown</styleUrl>
        <Point><coordinates>85.1550,27.9150,600</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Galchhi</name>
        <description><![CDATA[
          <b>Altitude:</b> 380 m (Distrito de Dhading)<br>
          <b>Função:</b> Entroncamento da Rodovia Pasang Lhamu com a Rodovia Prithvi.
        ]]></description>
        <styleUrl>#styleTown</styleUrl>
        <Point><coordinates>85.0200,27.8100,380</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Devghat (Foz Sagrada / Narayani)</name>
        <description><![CDATA[
          <b>Altitude:</b> 190 m (Confluência Trishuli + Kali Gandaki)<br>
          <b>Significado:</b> Santuário hindu sagrado e formação do Rio Narayani.
        ]]></description>
        <styleUrl>#styleTown</styleUrl>
        <Point><coordinates>84.4250,27.7120,190</coordinates></Point>
      </Placemark>
    </Folder>

