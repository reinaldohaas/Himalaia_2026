<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2"
     xmlns:kml="http://www.opengis.net/kml/2.2"
     xmlns:atom="http://www.w3.org/2005/Atom">
  <Document>
    <name>PROJETO MESTRE 3D: Rio Trishuli, Lago Lhende Khola e Infraestrutura</name>
    <open>1</open>
    <description><![CDATA[
      <div style="font-family: 'Segoe UI', Arial, sans-serif; padding: 12px; max-width: 420px; color: #1e293b;">
        <h2 style="color: #0284c7; margin-top: 0;">Mapeamento Completo da Bacia do Rio Trishuli</h2>
        <p><b>Abrangência:</b> Região do Tibete (Gyirong) até Devghat (Narayani), cobrindo os distritos de Rasuwa, Nuwakot, Dhading e Chitwan.</p>
        <p><b>Camadas Integradas:</b></p>
        <ul style="padding-left: 18px; margin: 6px 0;">
          <li><b>Lago e Geleira Lhende Khola:</b> Ponto de barramento e ruptura a 3.950m.</li>
          <li><b>Espinha Dorsal Hidrelétrica:</b> 8 Usinas Hidrelétricas e Barragens (>1.200 MW).</li>
          <li><b>Cidades e Vilas:</b> Gyirong, Rasuwagadhi, Timure, Syabrubesi, Dhunche, Mailung, Betrawati, Bidur e Devghat.</li>
          <li><b>Rodovias:</b> Pasang Lhamu Highway, G216 (China), Mid-Hill e Prithvi Highway.</li>
          <li><b>Censo de Pontes (ICIMOD):</b> 33 pontes com status de dano (25 destruídas, 3 danificadas, 5 poupadas).</li>
        </ul>
        <hr style="border: 0; border-top: 1px solid #cbd5e1;">
        <p style="font-size: 11px; color: #64748b;">Dados baseados no OpenStreetMap (Overpass), ICIMOD, UN OCHA HDX e satélites Copernicus.</p>
      </div>
    ]]></description>

    <!-- ESTILOS VISUAIS -->
    <Style id="styleLake">
      <LineStyle><color>ff00ffff</color><width>2.5</width></LineStyle>
      <PolyStyle><color>7f00aaff</color></PolyStyle>
    </Style>

    <Style id="styleGlacier">
