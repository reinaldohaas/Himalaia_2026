<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Catastrofe Transfronteirica Nepal-Tibete 2026</name>
    <description>Mapeamento 3D da avalanche de gelo-rocha, inundacao subita no Lhende Khola e impacto na fronteira Nepal-China</description>
    
    <!-- Estilos -->
    <Style id="avalancheOrigin">
      <IconStyle>
        <color>ff0000ff</color>
        <scale>1.4</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/caution.png</href></Icon>
      </IconStyle>
      <LabelStyle><scale>1.1</scale></LabelStyle>
    </Style>
    
    <Style id="hydroPlant">
      <IconStyle>
        <color>ffff00aa</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/lightning.png</href></Icon>
      </IconStyle>
    </Style>

    <Style id="borderPort">
      <IconStyle>
        <color>ff00aaff</color>
        <scale>1.3</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/flag.png</href></Icon>
      </IconStyle>
    </Style>

    <Style id="floodLine">
      <LineStyle>
        <color>ff0000ff</color>
        <width>6</width>
      </LineStyle>
    </Style>

    <!-- Visualizacao Inicial de Camera 3D no Google Earth -->
    <LookAt>
      <longitude>85.4400</longitude>
      <latitude>28.2500</latitude>
      <altitude>12000</altitude>
      <heading>35</heading>
      <tilt>60</tilt>
      <range>25000</range>
    </LookAt>

    <!-- Marcadores de Pontos Notaveis -->
    <Folder>
      <name>Pontos de Impacto e Instalacoes</name>
      
      <Placemark>
        <name>Origem do Colapso Glacial (Langtang Lirung 5.200m)</name>
        <description><![CDATA[
          <b>Data:</b> 26 Ago 2026 - 08:37 AM<br>
          <b>Altitude:</b> ~5.200 m (Queda de 1.200 m)<br>
          <b>Sinal Sismico:</b> 4.4 mb gerado pelo impacto de massa<br>
          <b>Descricao:</b> Desprendimento massivo de bloco de gelo e permafrost rochoso.
        ]]></description>
        <styleUrl>#avalancheOrigin</styleUrl>
        <Point>
          <coordinates>85.5194,28.2765,5200</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Barramento e Rompimento (Lhende Khola)</name>
        <description><![CDATA[
          <b>Altitude:</b> ~3.950 m<br>
          <b>Mecanismo:</b> Bloqueio fluvial por milhoes de m³ de detritos e rompimento violento em menos de 30 minutos.
        ]]></description>
        <styleUrl>#avalancheOrigin</styleUrl>
        <Point>
          <coordinates>85.4800,28.2740,3950</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Porto de Gyirong (Tibete, China)</name>
        <description><![CDATA[
          <b>Altitude:</b> ~2.700 m<br>
          <b>Status:</b> Soterrado por lama; comunicacoes e vias cortadas.<br>
          <b>Jurisdicao:</b> Regiao Autonoma do Tibete, China.
        ]]></description>
        <styleUrl>#borderPort</styleUrl>
        <Point>
          <coordinates>85.3300,28.3970,2700</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Forte & Aduana de Rasuwagadhi (Nepal)</name>
        <description><![CDATA[
          <b>Altitude:</b> 1.814 m<br>
          <b>Status:</b> Ponte da Amizade e patio alfandegario destruidos.
        ]]></description>
        <styleUrl>#borderPort</styleUrl>
        <Point>
          <coordinates>85.3810,28.2730,1814</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>UHE Rasuwagadhi (111 MW)</name>
        <description><![CDATA[
          <b>Capacidade:</b> 111 MW<br>
          <b>Dano:</b> Comportas, tuneis e desarenadores inundados de sedimentos.
        ]]></description>
        <styleUrl>#hydroPlant</styleUrl>
        <Point>
          <coordinates>85.3780,28.2650,1780</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Vila de Timure</name>
        <description><![CDATA[
          <b>Altitude:</b> 1.750 m<br>
          <b>Status:</b> Soterramento macico de dezenas de imoveis e caminhoes de frete.
        ]]></description>
        <styleUrl>#borderPort</styleUrl>
        <Point>
          <coordinates>85.3850,28.2520,1750</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Syabrubesi (Acesso Langtang)</name>
        <description><![CDATA[
          <b>Altitude:</b> 1.460 m<br>
          <b>Status:</b> Pontes rodoviarias e pênseis varridas pela cheia do Trishuli.
        ]]></description>
        <styleUrl>#borderPort</styleUrl>
        <Point>
          <coordinates>85.3370,28.1610,1460</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>UHE Upper Trishuli-3A (60 MW)</name>
        <description><![CDATA[
          <b>Altitude:</b> 850 m<br>
          <b>Distrito:</b> Nuwakot, Nepal<br>
          <b>Status:</b> Alerta maximo de vazao de detritos.
        ]]></description>
        <styleUrl>#hydroPlant</styleUrl>
        <Point>
          <coordinates>85.1800,27.9700,850</coordinates>
        </Point>
      </Placemark>
    </Folder>

    <!-- Vetor de Trajetoria da Enxurrada de Detritos -->
    <Placemark>
      <name>Eixo da Enxurrada de Lama e Blocos (45 km)</name>
      <description>Trilha da onda de detritos descendo da cota 5.200m ate 850m no vale do Trishuli</description>
      <styleUrl>#floodLine</styleUrl>
      <LineString>
        <extrude>1</extrude>
        <tessellate>1</tessellate>
        <altitudeMode>clampToGround</altitudeMode>
        <coordinates>
          85.5194,28.2765,5200
          85.4800,28.2740,3950
          85.4200,28.2750,2300
          85.3810,28.2730,1814
          85.3780,28.2650,1780
          85.3850,28.2520,1750
          85.3500,28.2000,1580
          85.3370,28.1610,1460
          85.3000,28.1130,1300
          85.2400,28.0400,1050
          85.1800,27.9700,850
        </coordinates>
      </LineString>
    </Placemark>

  </Document>
</kml>
