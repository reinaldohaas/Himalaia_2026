<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Catastrofe Transfronteirica Nepal-Tibete 2026</name>
    <description>Mapeamento 3D da avalanche de gelo-rocha, inundacao subita no Lhende Khola e impacto na fronteira Nepal-China</description>
    
    <!-- Estilos -->
    <Style id="avalancheOrigin">
      <IconStyle>
        <color>ff0000ff</color>
        <scale>1.4</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/caution.png</href></Icon>
      </IconStyle>
      <LabelStyle><scale>1.1</scale></LabelStyle>
    </Style>
    
    <Style id="hydroPlant">
      <IconStyle>
        <color>ffff00aa</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/lightning.png</href></Icon>
      </IconStyle>
    </Style>

    <Style id="borderPort">
      <IconStyle>
        <color>ff00aaff</color>
        <scale>1.3</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/flag.png</href></Icon>
      </IconStyle>
    </Style>

    <Style id="floodLine">
      <LineStyle>
        <color>e60000ff</color>
        <width>7</width>
      </LineStyle>
    </Style>

    <!-- Visualizacao Inicial de Camera 3D no Google Earth -->
    <LookAt>
      <longitude>85.4400</longitude>
      <latitude>28.2500</latitude>
      <altitude>12000</altitude>
      <heading>35</heading>
      <tilt>60</tilt>
      <range>25000</range>
    </LookAt>

    <!-- Marcadores de Pontos Notaveis -->
    <Folder>
      <name>Pontos de Impacto e Instalacoes</name>
      
      <Placemark>
        <name>Origem do Colapso Glacial (Langtang Lirung 5.200m)</name>
        <description><![CDATA[
          <b>Data:</b> 26 Ago 2026 - 08:37 AM<br>
          <b>Altitude:</b> ~5.200 m (Queda de 1.200 m)<br>
          <b>Sinal Sismico:</b> 4.4 mb gerado pelo impacto de massa<br>
          <b>Descricao:</b> Desprendimento massivo de bloco de gelo e permafrost rochoso.
        ]]></description>
        <styleUrl>#avalancheOrigin</styleUrl>
        <Point>
          <coordinates>85.5194,28.2765,5200</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Barramento e Rompimento (Lhende Khola)</name>
        <description><![CDATA[
          <b>Altitude:</b> ~3.950 m<br>
          <b>Mecanismo:</b> Bloqueio fluvial por milhoes de m³ de detritos e rompimento violento em menos de 30 minutos.
        ]]></description>
        <styleUrl>#avalancheOrigin</styleUrl>
        <Point>
          <coordinates>85.4800,28.2740,3950</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Porto de Gyirong (Tibete, China)</name>
        <description><![CDATA[
          <b>Altitude:</b> ~2.700 m<br>
          <b>Status:</b> Soterrado por lama; comunicacoes e vias cortadas.<br>
          <b>Jurisdicao:</b> Regiao Autonoma do Tibete, China.
        ]]></description>
        <styleUrl>#borderPort</styleUrl>
        <Point>
          <coordinates>85.3300,28.3970,2700</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Forte e Aduana de Rasuwagadhi (Nepal)</name>
        <description><![CDATA[
          <b>Altitude:</b> 1.814 m<br>
          <b>Status:</b> Ponte da Amizade e patio alfandegario destruidos.
        ]]></description>
        <styleUrl>#borderPort</styleUrl>
        <Point>
          <coordinates>85.3810,28.2730,1814</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>UHE Rasuwagadhi (111 MW)</name>
        <description><![CDATA[
          <b>Capacidade:</b> 111 MW<br>
          <b>Dano:</b> Comportas, tuneis e desarenadores inundados de sedimentos.
        ]]></description>
        <styleUrl>#hydroPlant</styleUrl>
        <Point>
          <coordinates>85.3780,28.2650,1780</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Vila de Timure</name>
        <description><![CDATA[
          <b>Altitude:</b> 1.750 m<br>
          <b>Status:</b> Soterramento macico de dezenas de imoveis e caminhoes de frete.
        ]]></description>
        <styleUrl>#borderPort</styleUrl>
        <Point>
          <coordinates>85.3850,28.2520,1750</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Syabrubesi (Acesso Langtang)</name>
        <description><![CDATA[
          <b>Altitude:</b> 1.460 m<br>
          <b>Status:</b> Pontes rodoviarias e pênseis varridas pela cheia do Trishuli.
        ]]></description>
        <styleUrl>#borderPort</styleUrl>
        <Point>
          <coordinates>85.3370,28.1610,1460</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>UHE Upper Trishuli-3A (60 MW)</name>
        <description><![CDATA[
          <b>Altitude:</b> 850 m<br>
          <b>Distrito:</b> Nuwakot, Nepal<br>
          <b>Status:</b> Alerta maximo de vazao de detritos.
        ]]></description>
        <styleUrl>#hydroPlant</styleUrl>
        <Point>
          <coordinates>85.1800,27.9700,850</coordinates>
        </Point>
      </Placemark>
    </Folder>

    <!-- Vetor de Trajetoria de Alta Precisao dentro do Leito do Rio -->
    <Placemark>
      <name>Eixo da Enxurrada de Lama e Blocos (45 km no Leito do Rio)</name>
      <description><![CDATA[
        <b>Traçado de Alta Precisão ao longo da Calha Fluvial:</b><br>
        1. Desprendimento da geleira a 5.200m no Mt. Langtang Lirung.<br>
        2. Queda e canalização na garganta do Rio Lhende Khola.<br>
        3. Confluência de fronteira no Rio Bhote Koshi (Forte Rasuwagadhi e Timure).<br>
        4. Meandros profundos do cânion do Rio Trishuli por Syabrubesi, Mailung e Betrawati até a UHE Trishuli-3A.
      ]]></description>
      <styleUrl>#floodLine</styleUrl>
      <LineString>
        <extrude>0</extrude>
        <tessellate>1</tessellate>
        <altitudeMode>clampToGround</altitudeMode>
        <coordinates>
          <!-- 1. Descida da geleira da face norte para a morena do Lhende Khola -->
          85.5194,28.2765,5200
          85.5080,28.2785,4800
          85.4960,28.2805,4450
          85.4850,28.2790,4150
          <!-- 2. Garganta do Rio Lhende Khola (trecho de fronteira) -->
          85.4800,28.2740,3950
          85.4680,28.2725,3700
          85.4540,28.2710,3450
          85.4410,28.2705,3200
          85.4280,28.2715,2950
          85.4150,28.2725,2700
          85.4020,28.2730,2450
          85.3910,28.2735,2150
          <!-- 3. Confluência no Rio Bhote Koshi / Forte de Rasuwagadhi -->
          85.3815,28.2732,1814
          85.3800,28.2685,1795
          85.3780,28.2650,1780
          85.3795,28.2610,1770
          85.3820,28.2565,1760
          85.3850,28.2520,1750
          85.3835,28.2460,1730
          <!-- 4. Desfiladeiro do Bhote Koshi para Tatopani e Ghatte Khola -->
          85.3800,28.2405,1705
          85.3760,28.2345,1680
          85.3720,28.2290,1655
          85.3680,28.2230,1630
          85.3640,28.2170,1605
          85.3590,28.2105,1580
          85.3540,28.2040,1555
          85.3480,28.1965,1530
          85.3425,28.1900,1505
          85.3385,28.1840,1485
          <!-- 5. Meandros por Syabrubesi e confluência do Langtang Khola -->
          85.3365,28.1760,1475
          85.3345,28.1680,1465
          85.3340,28.1610,1460
          85.3320,28.1540,1435
          85.3280,28.1470,1410
          85.3230,28.1400,1385
          85.3160,28.1325,1355
          85.3090,28.1250,1325
          85.3010,28.1180,1295
          85.2930,28.1110,1265
          <!-- 6. Cânion do Rio Trishuli descendo por Rongga, Mailung e Betrawati -->
          85.2855,28.1035,1235
          85.2780,28.0950,1200
          85.2720,28.0870,1165
          85.2655,28.0785,1130
          85.2585,28.0700,1095
          85.2520,28.0610,1060
          85.2450,28.0520,1030
          85.2380,28.0425,1000
          85.2310,28.0330,970
          85.2240,28.0235,940
          85.2160,28.0130,910
          85.2070,28.0020,885
          85.1980,27.9910,865
          85.1890,27.9805,845
          85.1800,27.9700,830
        </coordinates>
      </LineString>
    </Placemark>

  </Document>
</kml>
